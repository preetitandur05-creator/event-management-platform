# ============================================
# Event Management Platform — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================

# Database (Neon Postgres recommended)
# Get from: https://console.neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"

# NextAuth
# Generate with: openssl rand -base64 32
NEXTAUTH_SECRET="your-secret-here-change-this"
NEXTAUTH_URL="http://localhost:3000"

# Admin credentials (for initial setup)
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="changeme123"

# Resend (email)
# Get from: https://resend.com
RESEND_API_KEY="re_xxxx"
RESEND_FROM_EMAIL="events@yourdomain.com"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
NEXT_PUBLIC_EVENT_NAME="SAMANVAYA 2027"
