# ============================================================
# EVENT MANAGEMENT PLATFORM - ENVIRONMENT VARIABLES
# ============================================================
# Add these in Vercel → Project → Settings → Environment Variables
# NEVER commit real secrets to GitHub.
# ============================================================

# ---------- REQUIRED ----------

# Neon PostgreSQL connection string
# From console.neon.tech → your project → Connect
# Prefer the "Pooled connection" string for Vercel
DATABASE_URL="postgresql://user:password@ep-xxx.us-east-2.aws.neon.tech/neondb?sslmode=require"

# App URL (set after first deploy to your real Vercel URL)
NEXT_PUBLIC_APP_URL="https://your-project.vercel.app"

# Auth secret (generate: openssl rand -base64 32)
AUTH_SECRET="change-me-to-a-long-random-string-at-least-32-chars"

# ---------- REQUIRED for emails (Resend) ----------
RESEND_API_KEY="re_xxxxxxxxxxxxxxxxxxxxxxxxxxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="SAMANVAYA 2027"
