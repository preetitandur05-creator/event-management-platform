# ============================================
# Event Management Platform — Environment Variables
# Copy this file to .env.local and fill in your values
# ============================================

# Database (Neon Postgres recommended)
# Get from: https://console.neon.tech
DATABASE_URL="postgresql://user:password@host/dbname?sslmode=require"
DATABASE_URL_UNPOOLED="postgresql://user:password@host/dbname?sslmode=require"

# Auth (NextAuth / Auth.js)
# Generate with: openssl rand -base64 32
AUTH_SECRET="your-secret-here-change-this"
NEXTAUTH_URL="http://localhost:3000"

# Resend (email)
# Get from: https://resend.com
RESEND_API_KEY="re_xxxx"
RESEND_FROM_EMAIL="onboarding@resend.dev"
RESEND_FROM_NAME="SAMANVAYA 2027"

# App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
